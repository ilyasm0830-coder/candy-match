rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n','av','stars','lv','pts','t','fr'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 12
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 150
        && request.resource.data.lv is int && request.resource.data.lv >= 0 && request.resource.data.lv <= 50
        && request.resource.data.pts is int
        && (!('fr' in request.resource.data) || (request.resource.data.fr is int && request.resource.data.fr >= 0 && request.resource.data.fr <= 24));
    }
  }
}
